        </td>
    </tr>
    `;

}


function approve(id){

    let account=
    db.accounts.find(
        x=>x.id===id
    );

    if(!account)
        return;

    account.status=
    "approved";

    save();

    refresh();

    alert(
        "تمت الموافقة على الحساب ✅"
    );

}


