/* =========================
   INVOICE
========================= */

function createInvoice(){

    if(!cart.length){

        alert(
            "أضف منتجات أولاً"
        );

        return;

    }

    let total=
    cart.reduce(
        (a,item)=>{

            let p=
            db.products.find(
                x=>x.id===item.id
            );

            return a+
            p.price*item.qty;

        },
        0
    );

    let paid=
    Number(
        document.getElementById(
            "paidAmount"
        ).value
    )||0;

    let customerId=
    document.getElementById(
        "saleCustomer"
    ).value;

    let customer=
    db.customers.find(
        x=>x.id==customerId
    );

    let remaining=
    Math.max(
        0,
        total-paid
    );

    if(remaining>0&&!customer){

        alert(
            "لو فيه مبلغ متبقي لازم تختار عميل"
        );

        return;

    }

    cart.forEach(item=>{

        let p=
        db.products.find(
            x=>x.id===item.id
        );

        p.stock-=item.qty;

    });

    if(customer){

        customer.debt+=remaining;

    }

    let invoice={

        number:
        "INV-"+
        String(
            db.invoices.length+1
        ).padStart(5,"0"),

        date:
        new Date().toISOString(),

        customer:
        customer?.name||"نقدي",

        items:
        cart.map(item=>{

            let p=
            db.products.find(
                x=>x.id===item.id
            );

            return{

                name:p.name,

                qty:item.qty,

                price:p.price

            };

        }),

        total,

        paid,

        remaining

    };

    db.invoices.push(
        invoice
    );

    save();

    cart=[];

    document
    .getElementById(
        "paidAmount"
    )
    .value=0;

    alert(
        "تم إنشاء الفاتورة رقم "+
        invoice.number
    );

    refresh();

}


