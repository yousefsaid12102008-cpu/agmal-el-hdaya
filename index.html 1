<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>مكتبة أجمل الهدايا</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Tahoma,Arial,sans-serif;
}

:root{
    --gold:#f5c542;
    --gold2:#ffdf70;
    --dark:#09070a;
    --dark2:#171019;
    --card:#211922;
    --text:#fff;
    --muted:#aaa;
    --red:#e74c3c;
    --green:#21c77a;
}

body{
    background:
    radial-gradient(circle at 20% 20%,#5a3a0025,transparent 30%),
    radial-gradient(circle at 80% 70%,#f5c54218,transparent 30%),
    var(--dark);
    color:white;
    min-height:100vh;
    overflow-x:hidden;
}

/* =========================
   ANIMATED BACKGROUND
========================= */

.bg{
    position:fixed;
    inset:0;
    overflow:hidden;
    pointer-events:none;
    z-index:-1;
}

.circle{
    position:absolute;
    border-radius:50%;
    filter:blur(2px);
    opacity:.25;
    animation:float 9s infinite ease-in-out;
}

.c1{
    width:220px;
    height:220px;
    background:#f5c542;
    top:8%;
    left:5%;
}

.c2{
    width:170px;
    height:170px;
    background:#9b59b6;
    right:8%;
    top:30%;
    animation-delay:2s;
}

.c3{
    width:250px;
    height:250px;
    background:#f39c12;
    bottom:5%;
    left:40%;
    animation-delay:4s;
}

@keyframes float{

    0%,100%{
        transform:translate(0,0) scale(1);
    }

    50%{
        transform:translate(30px,-35px) scale(1.12);
    }
}

/* =========================
   SPLASH
========================= */

#splash{
    position:fixed;
    inset:0;
    z-index:9999;
    background:
    radial-gradient(circle,#3a2704,#09070a 65%);
    display:flex;
    justify-content:center;
    align-items:center;
    flex-direction:column;
    transition:1s;
}

.splash-logo{
    width:210px;
    height:210px;
    object-fit:contain;
    animation:
    logoEnter 1.5s ease,
    logoFloat 3s 1.5s infinite ease-in-out;
    filter:
    drop-shadow(0 0 15px #f5c542)
    drop-shadow(0 0 45px #f5c54255);
}

@keyframes logoEnter{

    from{
        transform:scale(.3) rotate(-20deg);
        opacity:0;
    }

    to{
        transform:scale(1) rotate(0);
        opacity:1;
    }
}

@keyframes logoFloat{

    0%,100%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-12px);
    }
}

.splash-title{
    margin-top:20px;
    font-size:30px;
    font-weight:900;
    color:var(--gold2);
    animation:titleShow 1.5s ease;
}

.splash-sub{
    margin-top:10px;
    color:#ddd;
    animation:titleShow 2s ease;
}

@keyframes titleShow{

    from{
        opacity:0;
        transform:translateY(30px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }
}

/* =========================
   WELCOME
========================= */

#welcome{
    position:fixed;
    inset:0;
    z-index:9998;
    display:none;
    justify-content:center;
    align-items:center;
    background:#080609ee;
}

.welcome-box{
    text-align:center;
    animation:welcome 1s ease;
}

@keyframes welcome{

    from{
        opacity:0;
        transform:scale(.7) translateY(40px);
    }

    to{
        opacity:1;
        transform:scale(1) translateY(0);
    }
}

.welcome-small{
    color:#aaa;
    font-size:18px;
}

.welcome-name{
    margin-top:10px;
    font-size:45px;
    font-weight:900;
    background:linear-gradient(
        90deg,
        #fff,
        #f5c542,
        #fff
    );
    background-size:200%;
    -webkit-background-clip:text;
    color:transparent;
    animation:goldMove 2s infinite linear;
}

@keyframes goldMove{
    to{
        background-position:200%;
    }
}

.welcome-line{
    width:100px;
    height:4px;
    background:var(--gold);
    margin:20px auto;
    border-radius:10px;
    animation:lineGrow 1s ease;
}

@keyframes lineGrow{
    from{width:0}
    to{width:100px}
}

/* =========================
   AUTH
========================= */

.auth{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:25px;
}

.auth-card{
    width:100%;
    max-width:440px;
    background:#171219e8;
    border:1px solid #f5c54230;
    border-radius:30px;
    padding:30px;
    box-shadow:
    0 30px 100px #000,
    inset 0 0 40px #f5c54208;
    backdrop-filter:blur(20px);
    animation:cardIn .8s ease;
}

@keyframes cardIn{

    from{
        opacity:0;
        transform:translateY(40px) scale(.95);
    }

    to{
        opacity:1;
        transform:none;
    }
}

.auth-logo{
    width:105px;
    height:105px;
    object-fit:contain;
    display:block;
    margin:auto;
    filter:drop-shadow(0 0 15px #f5c54266);
}

.auth-title{
    text-align:center;
    margin-top:10px;
    font-size:27px;
}

.auth-sub{
    text-align:center;
    color:#999;
    margin:8px 0 25px;
}

.field{
    margin-bottom:14px;
}

.field label{
    display:block;
    margin-bottom:7px;
    color:#ddd;
}

.field input,
.field select{
    width:100%;
    padding:14px;
    border-radius:13px;
    border:1px solid #ffffff12;
    background:#0e0b0f;
    color:#fff;
    outline:none;
    transition:.3s;
}

.field input:focus,
.field select:focus{
    border-color:var(--gold);
    box-shadow:0 0 0 3px #f5c54212;
}

.btn{
    border:0;
    padding:13px 18px;
    border-radius:13px;
    cursor:pointer;
    font-weight:bold;
    transition:.25s;
}

.btn:hover{
    transform:translateY(-2px);
}

.btn-gold{
    width:100%;
    background:linear-gradient(
        135deg,
        #b98500,
        #f5c542,
        #ffe68a
    );
    color:#1a1200;
    box-shadow:0 10px 30px #f5c54220;
}

.btn-dark{
    background:#29222b;
    color:#fff;
}

.auth-switch{
    text-align:center;
    margin-top:18px;
    color:#aaa;
}

.auth-switch span{
    color:var(--gold);
    cursor:pointer;
    font-weight:bold;
}

/* =========================
   HEADER
========================= */

#app{
    display:none;
}

.header{
    position:sticky;
    top:0;
    z-index:100;
    height:75px;
    background:#0c090dcc;
    backdrop-filter:blur(20px);
    border-bottom:1px solid #ffffff0c;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 25px;
}

.header-brand{
    display:flex;
    align-items:center;
    gap:12px;
}

.header-brand img{
    width:48px;
    height:48px;
    object-fit:contain;
}

.header-brand b{
    color:var(--gold2);
}

.header-right{
    display:flex;
    align-items:center;
    gap:15px;
}

.phone{
    color:#aaa;
    font-size:13px;
}

/* =========================
   SIDEBAR
========================= */

.layout{
    display:flex;
}

.sidebar{
    width:245px;
    min-height:calc(100vh - 75px);
    background:#110d12;
    border-left:1px solid #ffffff08;
    padding:20px 14px;
    position:sticky;
    top:75px;
}

.menu-title{
    color:#666;
    font-size:12px;
    margin:10px;
}

.menu-btn{
    width:100%;
    background:none;
    border:0;
    color:#aaa;
    padding:14px;
    border-radius:13px;
    text-align:right;
    cursor:pointer;
    margin-bottom:5px;
    transition:.2s;
}

.menu-btn:hover,
.menu-btn.active{
    background:linear-gradient(
        90deg,
        #f5c54218,
        #f5c54205
    );
    color:var(--gold2);
}

/* =========================
   CONTENT
========================= */

.content{
    flex:1;
    padding:28px;
    max-width:1500px;
}

.page{
    display:none;
    animation:pageIn .4s ease;
}

.page.active{
    display:block;
}

@keyframes pageIn{

    from{
        opacity:0;
        transform:translateY(15px);
    }

    to{
        opacity:1;
        transform:none;
    }
}

.page-head{
    margin-bottom:22px;
}

.page-head h1{
    font-size:30px;
}

.page-head p{
    color:#888;
    margin-top:6px;
}

/* =========================
   DASHBOARD
========================= */

.cards{
    display:grid;
    grid-template-columns:
    repeat(4,1fr);
    gap:15px;
}

.stat{
    background:
    linear-gradient(
        145deg,
        #241c24,
        #151016
    );
    border:1px solid #ffffff08;
    border-radius:20px;
    padding:20px;
    position:relative;
    overflow:hidden;
}

.stat:after{
    content:"";
    position:absolute;
    width:100px;
    height:100px;
    background:#f5c54215;
    border-radius:50%;
    left:-30px;
    bottom:-40px;
}

.stat-icon{
    font-size:27px;
}

.stat-label{
    color:#888;
    margin-top:12px;
}

.stat-number{
    font-size:28px;
    font-weight:900;
    margin-top:5px;
}

/* =========================
   SECTIONS
========================= */

.panel{
    background:#171219;
    border:1px solid #ffffff08;
    border-radius:20px;
    padding:20px;
    margin-top:18px;
}

.panel-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:10px;
    margin-bottom:15px;
}

.table-wrap{
    overflow:auto;
}

table{
    width:100%;
    border-collapse:collapse;
}

th,
td{
    padding:13px;
    border-bottom:1px solid #ffffff08;
    text-align:right;
}

th{
    color:#777;
    font-size:13px;
}

td{
    color:#ddd;
}

/* =========================
   POS
========================= */

.pos-grid{
    display:grid;
    grid-template-columns:
    1.4fr .8fr;
    gap:18px;
}

.products{
    display:grid;
    grid-template-columns:
    repeat(3,1fr);
    gap:12px;
}

.product{
    background:#211922;
    border:1px solid #ffffff08;
    border-radius:17px;
    padding:15px;
    transition:.25s;
}

.product:hover{
    transform:translateY(-4px);
    border-color:#f5c54245;
    box-shadow:0 15px 40px #0005;
}

.product-icon{
    height:100px;
    border-radius:13px;
    background:
    radial-gradient(
        circle,
        #f5c54220,
        #0d0a0e
    );
    display:grid;
    place-items:center;
    font-size:40px;
    margin-bottom:12px;
}

.product-name{
    font-weight:bold;
}

.product-price{
    color:var(--gold2);
    font-weight:bold;
    margin:8px 0;
}

.cart{
    background:#171219;
    border-radius:20px;
    padding:20px;
    position:sticky;
    top:95px;
    height:max-content;
}

.cart-item{
    display:flex;
    justify-content:space-between;
    gap:10px;
    padding:12px 0;
    border-bottom:1px solid #ffffff08;
}

.total-box{
    margin-top:15px;
    border-top:1px dashed #ffffff20;
    padding-top:15px;
}

.total-line{
    display:flex;
    justify-content:space-between;
    margin:9px 0;
}

.total-main{
    font-size:24px;
    color:var(--gold2);
    font-weight:900;
}

/* =========================
   MOBILE
========================= */

.mobile-nav{
    display:none;
}

@media(max-width:1000px){

    .sidebar{
        display:none;
    }

    .cards{
        grid-template-columns:
        repeat(2,1fr);
    }

    .pos-grid{
        grid-template-columns:1fr;
    }

    .cart{
        position:static;
    }

    .mobile-nav{
        display:flex;
        position:fixed;
        bottom:0;
        left:0;
        right:0;
        z-index:200;
        background:#110d12ee;
        backdrop-filter:blur(15px);
        border-top:1px solid #ffffff12;
        justify-content:space-around;
        padding:8px;
    }

    .mobile-nav button{
        background:none;
        color:#999;
        border:0;
        font-size:11px;
    }

}

@media(max-width:650px){

    .header{
        padding:0 12px;
    }

    .phone{
        display:none;
    }

    .content{
        padding:18px 13px 90px;
    }

    .cards{
        grid-template-columns:1fr 1fr;
        gap:9px;
    }

    .stat{
        padding:14px;
    }

    .stat-number{
        font-size:20px;
    }

    .products{
        grid-template-columns:
        repeat(2,1fr);
    }

    .welcome-name{
        font-size:31px;
    }

}

</style>
</head>

