                <th>السعر</th>
            </tr>

            ${
                invoice.items.map(
                    i=>`
                    <tr>
                        <td>${i.name}</td>
                        <td>${i.qty}</td>
                        <td>${money(
                            i.price*i.qty
                        )}</td>
                    </tr>
                    `
                ).join("")
            }

        </table>

        <div class="total">
            الإجمالي:
            ${money(invoice.total)}
        </div>

        <div>
            المدفوع:
            ${money(invoice.paid)}
        </div>

        <div>
            المتبقي:
            ${money(invoice.remaining)}
        </div>

        <br>

        <center>
            شكرًا لتعاملكم معنا ❤️
        </center>

        <script>
            window.print();
        <\/script>

    </body>

    </html>

    `);

    w.document.close();

}


