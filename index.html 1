let cart=[];

function addToCart(id){

    let p=
    db.products.find(
        x=>x.id===id
    );

    if(!p||p.stock<=0){

        alert(
            "المنتج غير متوفر"
        );

        return;

    }

    let item=
    cart.find(
        x=>x.id===id
    );

    if(item)
        item.qty++;
    else
        cart.push({
            id,
            qty:1
        });

    renderCart();

}


function renderCart(){

    let box=
    document.getElementById(
        "cartItems"
    );

    if(!cart.length){

        box.innerHTML=
        `<p style="color:#777">
            لا توجد منتجات في الفاتورة
        </p>`;

        document
        .getElementById(
            "cartTotal"
        )
        .textContent="0 ج";

        return;

    }

    let total=0;

    box.innerHTML=
    cart.map(item=>{

        let p=
        db.products.find(
            x=>x.id===item.id
        );

        let t=
        p.price*item.qty;

        total+=t;

        return `

        <div class="cart-item">

            <div>

                <b>
                    ${p.name}
                </b>

                <br>

                <small>
                    ${item.qty} ×
                    ${money(p.price)}
                </small>

            </div>

            <div>

                <b>
                    ${money(t)}
                </b>

                <br>

                <button
                    class="btn btn-dark"
                    onclick="removeCart(${p.id})"
                >
                    ×
                </button>

            </div>

        </div>

        `;

    })
    .join("");

    document
    .getElementById(
        "cartTotal"
    )
    .textContent=
    money(total);

}


function removeCart(id){

    cart=
    cart.filter(
        x=>x.id!==id
    );

    renderCart();

}


